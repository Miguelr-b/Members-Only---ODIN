<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Cadastro</title>
</head>
<body>
  <h1>Cadastro</h1>

  <% if (locals.errors && errors.length) { %>
    <ul style="color: red;">
      <% errors.forEach(e => { %>
        <li><%= e.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/user/register" method="POST">
    <label>Username <input name="username" required value="<%= (locals.values && values.username) || '' %>"></label><br>
    <label>Nome <input name="name" required value="<%= (locals.values && values.name) || '' %>"></label><br>
    <label>Email <input name="email" type="email" required value="<%= (locals.values && values.email) || '' %>"></label><br>
    <label>Senha <input name="password" type="password" required></label><br>
    <button type="submit">Cadastrar</button>
  </form>

  <p>Já tem conta? <a href="/user/login">Entrar</a></p>
</body>
</html>